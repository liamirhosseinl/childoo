<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">چایلدو</string>
    <string name="back">بازگشت</string>

    <!-- Onboarding -->
    <string name="ob_welcome_title">زمان صفحه رو به زمان یادگیری تبدیل کن</string>
    <string name="ob_welcome_body">بچه‌ات به بازی‌اش ادامه می‌ده. هر چند وقت یک بار، نوزو با یه چالش کوتاه و دوستانه سر می‌زنه و دور بعدی بازی رو باز می‌کنه.</string>
    <string name="ob_welcome_cta">بزن بریم</string>

    <string name="ob_apps_title">کدوم اپ‌ها زمان صفحه حساب می‌شن؟</string>
    <string name="ob_apps_body">اپ‌هایی رو انتخاب کن که زمان بازی توشون شمرده بشه. بقیه آزادن.</string>
    <string name="ob_apps_cta_empty">حداقل یک اپ انتخاب کن</string>
    <plurals name="ob_apps_cta">
        <item quantity="one">ادامه با %1$s اپ</item>
        <item quantity="other">ادامه با %1$s اپ</item>
    </plurals>
    <string name="ob_continue">ادامه</string>

    <string name="ob_interval_title">نوزو هر چند وقت سر بزنه؟</string>
    <string name="ob_interval_body">بعد از این مقدار بازی توی اپ‌های انتخاب‌شده، یه چالش ۶۰ ثانیه‌ای ظاهر می‌شه.</string>
    <string name="interval_30_label">متعادل</string>
    <string name="interval_30_note">هر نیم ساعت بازی، یک چالش.</string>
    <string name="interval_15_label">تمرین بیشتر</string>
    <string name="interval_15_note">دو برابر چالش برای بچه‌هایی که زیاد بازی می‌کنن.</string>
    <string name="interval_5_label">فشرده</string>
    <string name="interval_5_note">برای جلسه‌های کوتاه یا جبران عقب‌ماندگی.</string>
    <string name="interval_1_label">امتحانی</string>
    <string name="interval_1_note">همین الان ببین چطور کار می‌کنه، بعد برگردون.</string>
    <string name="unit_min">دقیقه</string>
    <string name="interval_short">%1$s دقیقه</string>
    <string name="badge_recommended">پیشنهادی</string>
    <string name="badge_required">ضروری</string>

    <string name="ob_perms_title">چند تا دسترسی کوتاه</string>
    <string name="ob_perms_body">چایلدو این‌ها رو لازم داره تا بفهمه کِی یه اپ انتخاب‌شده بازه و چالش رو روش نشون بده. هیچ اطلاعاتی از این گوشی خارج نمی‌شه.</string>
    <string name="ob_perms_cta_blocked">برای ادامه، موارد ضروری رو فعال کن</string>

    <string name="ob_xiaomi_title">یه قدم دیگه برای شیائومی</string>
    <string name="ob_xiaomi_body">گوشی‌های شیائومی اپ‌های پس‌زمینه رو خیلی سریع می‌بندن. این دو تا کلید باعث می‌شن چایلدو همیشه کار کنه.</string>

    <string name="ob_ready_title">همه‌چی آماده‌ست!</string>
    <string name="ob_ready_body">محافظت رو روشن کن و گوشی رو بده دست بچه. از این‌جا به بعد با نوزو.</string>
    <string name="ob_ready_cta">روشن کردن محافظت</string>
    <string name="summary_apps">اپ محافظت‌شده</string>
    <string name="summary_interval">دقیقه برای هر چالش</string>
    <string name="test_challenge">پیش‌نمایش یه چالش</string>

    <!-- Permissions -->
    <string name="perm_usage_title">دسترسی به آمار استفاده</string>
    <string name="perm_usage_body">برای اینکه بفهمیم کِی یه اپ انتخاب‌شده بازه.</string>
    <string name="perm_overlay_title">نمایش روی برنامه‌های دیگر</string>
    <string name="perm_overlay_body">برای اینکه چالش روی بازی نشون داده بشه.</string>
    <string name="perm_notifications_title">اعلان‌ها</string>
    <string name="perm_notifications_body">یه اعلان آروم که نشون می‌ده محافظت روشنه.</string>
    <string name="perm_battery_title">باتری بدون محدودیت</string>
    <string name="perm_battery_body">تا گوشی هیچ‌وقت محافظت رو متوقف نکنه.</string>
    <string name="perm_grant">اجازه</string>
    <string name="perm_granted">فعال شد</string>

    <string name="restricted_title">پیغام «App was denied access» می‌بینی؟</string>
    <string name="restricted_body">اندروید برای اپ‌هایی که خارج از فروشگاه نصب شدن یه قفل اضافه می‌ذاره. برداشتنش ده ثانیه طول می‌کشه:</string>
    <string name="restricted_step1">پایین روی «باز کردن اطلاعات برنامه» بزن.</string>
    <string name="restricted_step2">گوشه‌ی بالا روی ⋮ بزن، گزینه‌ی Allow restricted settings رو انتخاب و تأیید کن.</string>
    <string name="restricted_step3">برگرد این‌جا و دوباره روی «اجازه» در بخش آمار استفاده بزن.</string>
    <string name="restricted_open_app_info">باز کردن اطلاعات برنامه</string>

    <string name="xiaomi_autostart_title">شروع خودکار</string>
    <string name="xiaomi_autostart_body">تا محافظت بعد از خاموش و روشن شدن گوشی دوباره شروع بشه.</string>
    <string name="xiaomi_popups_title">پنجره‌های بازشو</string>
    <string name="xiaomi_popups_body">توی «سایر مجوزها»، گزینه‌ی «نمایش پنجره‌های بازشو هنگام اجرا در پس‌زمینه» رو مجاز کن.</string>
    <string name="xiaomi_opened_hint">باز شد. اون‌جا روشنش کن و برگرد.</string>

