<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Childoo</string>
    <string name="back">Back</string>

    <!-- Onboarding -->
    <string name="ob_welcome_title">Turn screen time into brain time</string>
    <string name="ob_welcome_body">Your child keeps playing. Every so often, Nuzo pops in with a quick, friendly challenge that unlocks the next round of play.</string>
    <string name="ob_welcome_cta">Let\'s set it up</string>

    <string name="ob_apps_title">Which apps cost screen time?</string>
    <string name="ob_apps_body">Pick the apps where play time should be counted. Everything else stays free.</string>
    <string name="ob_apps_cta_empty">Pick at least one app</string>
    <plurals name="ob_apps_cta">
        <item quantity="one">Continue with %1$s app</item>
        <item quantity="other">Continue with %1$s apps</item>
    </plurals>
    <string name="ob_continue">Continue</string>

    <string name="ob_interval_title">How often should Nuzo drop by?</string>
    <string name="ob_interval_body">After this much play in the chosen apps, a 60-second challenge appears.</string>
    <string name="interval_30_label">Balanced</string>
    <string name="interval_30_note">One challenge per half hour of play.</string>
    <string name="interval_15_label">Extra practice</string>
    <string name="interval_15_note">Twice as many challenges for heavy players.</string>
    <string name="interval_5_label">Intensive</string>
    <string name="interval_5_note">For short sessions or catching up.</string>
    <string name="interval_1_label">Try it out</string>
    <string name="interval_1_note">See it in action right away, then switch back.</string>
    <string name="unit_min">min</string>
    <string name="interval_short">%1$s min</string>
    <string name="badge_recommended">Recommended</string>
    <string name="badge_required">Required</string>

    <string name="ob_perms_title">A few quick permissions</string>
    <string name="ob_perms_body">Childoo needs these to notice when a chosen app is open and to show the challenge on top. Nothing ever leaves this phone.</string>
    <string name="ob_perms_cta_blocked">Allow the required ones to continue</string>

    <string name="ob_xiaomi_title">One more step on Xiaomi</string>
    <string name="ob_xiaomi_body">Xiaomi phones close background apps aggressively. These two switches keep Childoo running reliably.</string>

    <string name="ob_ready_title">You\'re all set!</string>
    <string name="ob_ready_body">Turn on protection and hand the phone back. Nuzo takes it from here.</string>
    <string name="ob_ready_cta">Turn on protection</string>
    <string name="summary_apps">apps protected</string>
    <string name="summary_interval">minutes per challenge</string>
    <string name="test_challenge">Preview a challenge</string>

    <!-- Permissions -->
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_body">To notice when a chosen app is open.</string>
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_body">To show the challenge on top of the game.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">A quiet notice that protection is running.</string>
    <string name="perm_battery_title">Unrestricted battery</string>
    <string name="perm_battery_body">So the phone never pauses protection.</string>
    <string name="perm_grant">Allow</string>
    <string name="perm_granted">Allowed</string>

    <string name="restricted_title">Seeing \"App was denied access\"?</string>
    <string name="restricted_body">Android adds an extra lock for apps installed outside an app store. Lifting it takes ten seconds:</string>
    <string name="restricted_step1">Tap Open app info below.</string>
    <string name="restricted_step2">Tap ⋮ in the top corner, choose Allow restricted settings and confirm.</string>
    <string name="restricted_step3">Come back here and tap Allow on Usage access again.</string>
    <string name="restricted_open_app_info">Open app info</string>

    <string name="xiaomi_autostart_title">Autostart</string>
    <string name="xiaomi_autostart_body">Lets protection restart after the phone reboots.</string>
    <string name="xiaomi_popups_title">Pop-up windows</string>
    <string name="xiaomi_popups_body">In Other permissions, allow \"Display pop-up windows while running in the background\".</string>
    <string name="xiaomi_opened_hint">Opened. Switch it on there, then come back.</string>

    <!-- App picker -->
